<form method="post" action="{{ path('app_voiture_delete', {'immatriculation': voiture.immatriculation}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet élément ?');" style="display:inline;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ voiture.immatriculation) }}">
    <button type="submit" class="btn-link">Supprimer</button>
</form>
