<form method="post" action="{{ path('app_chauffeur_delete', {'codeChauffeur': chauffeur.codeChauffeur}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet élément ?');" style="display:inline;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ chauffeur.codeChauffeur) }}">
    <button type="submit" class="btn-link">Supprimer</button>
</form>
