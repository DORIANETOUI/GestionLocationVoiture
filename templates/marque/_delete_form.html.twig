<form method="post" action="{{ path('app_marque_delete', {'codeMarque': marque.codeMarque}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet élément');" style="display:inline;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ marque.codeMarque) }}">
    <button type="submit" class="btn-link">Supprimer</button>
</form>
