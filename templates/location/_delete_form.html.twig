<form method="post" action="{{ path('app_location_delete', {'codeLocation': location.codeLocation}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet élément ?');" style="display:inline;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ location.codeLocation) }}">
    <button type="submit" class="btn-link">Supprimer</button>
</form>

