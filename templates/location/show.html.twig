{% extends 'base.html.twig' %}

{% block title %}Location{% endblock %}

{% block body %}

    <div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Location</h1>
    <a href="{{ path('app_location_pdf_single', {'codeLocation': location.codeLocation}) }}" class="btn-link">
      PDF<span class="glyphicon glyphicon-save"></span>

    </a>
</div>  

    <table class="table">
        <tbody>
            <tr>
                <th>Code </th>
                <td>{{ location.codeLocation }}</td>
            </tr>
            <tr>
                <th>Date de début</th>
                <td>{{ location.dateDebutLocation ? location.dateDebutLocation|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Date de fin</th>
                <td>{{ location.dateFinLocation ? location.dateFinLocation|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Immatriculation</th>
                <td>{{ location.voiture ? location.voiture.immatriculation : '' }}</td>
            </tr>
            <tr>
                <th>Marque</th>
                <td>{{ location.voiture ? location.voiture.marque.libelleMarque : '' }}</td>
            </tr>
            <tr>
                <th>Modèle</th>
                <td>{{ location.voiture ? location.voiture.modele : '' }}</td>
            </tr>
            <tr>
                <th>Prix (CFA)</th>
                <td>{{ location.prixLocation }} F CFA</td>
            </tr>
             <tr>
                <th>Destination</th>
                <td>{{ location.destination}}</td>
            </tr>
            <tr>
                <th>Nom du Client</th>
                <td>{{ location.client ? location.client.nomClient : '' }}</td>
            </tr>
            

            <tr>
                <th>Nom du Chauffeur</th>
                <td>{{ location.chauffeur ? location.chauffeur.nomChauffeur ~ ' ' ~ location.chauffeur.prenomChauffeur : '' }}</td>
            </tr>

            <tr>
                <th>Date de retour</th>
                <td> 
                    {% if location.rendu %}
                    {{ location.rendu|date('d/m/Y H:i') }}
                    {% else %}
                        <a href="{{ path('app_location_update_render_date', {'codeLocation': location.codeLocation}) }}" >Inserer une date</a>
                    {% endif %}
                </td>
            </tr>

        </tbody>
    </table>

    <a href="{{ path('app_location_index') }}" class="btn-link">Retour à la liste</a>

    <a href="{{ path('app_location_edit', {'codeLocation': location.codeLocation}) }}" class="btn-link">Modifier</a>

    {{ include('location/_delete_form.html.twig') }}
{% endblock %}
